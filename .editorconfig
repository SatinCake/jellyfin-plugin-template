root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# C# style preferences and analyzers
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_open_brace = all

# Keep StyleCop strict; we rely on jellyfin.ruleset for specifics

